{
  "name": "workbench-app",
  "version": "0.1.0",
  "private": true,
  "description": "Personal AI Workbench 桌面版（Electron 启动器）",
  "author": "breezehf",
  "main": "electron/main.js",
  "scripts": {
    "dev": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.breezehf.workbenchapp",
    "productName": "Personal Workbench",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/seed.tar.gz",
        "to": "seed.tar.gz"
      },
      {
        "from": "build/seed-version.txt",
        "to": "seed-version.txt"
      }
    ],
    "electronDist": "node_modules/electron/dist",
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "electron-winstaller@5.4.0": true
  }
}
